# ========================================================
# Defence Frontend Environment Configuration Example
# ========================================================

# 1. LOCAL DEVELOPMENT (.env.local or .env.development)
# ----------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_PATH=

# 2. PRODUCTION SERVER (.env.production for princedefence.com/test)
# ---------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://princedefence.com/test-api/api
# NEXT_PUBLIC_SITE_URL=https://princedefence.com/test
# NEXT_PUBLIC_BASE_PATH=/test
